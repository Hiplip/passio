{
  "name": "passio",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @passio/extension build && vitest run",
    "build": "pnpm --filter @passio/web build",
    "smoke": "pnpm --filter @passio/web smoke",
    "dev": "pnpm --filter @passio/web dev",
    "start": "pnpm --filter @passio/web start",
    "preview": "pnpm --filter @passio/web preview",
    "build:extension": "pnpm --filter @passio/extension build",
    "icons": "node scripts/make-icons.mjs",
    "db:generate": "pnpm --filter @passio/web db:generate",
    "db:migrate": "pnpm --filter @passio/web db:migrate",
    "db:push": "pnpm --filter @passio/web db:push",
    "db:studio": "pnpm --filter @passio/web db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.5.2"
}
