{
  // Covers only the workspace-root config files. Each app and package has its
  // own tsconfig; this one exists so ESLint's typed rules have a project to
  // resolve vitest.config.ts against. `pnpm typecheck` runs `pnpm -r typecheck`
  // and does not use this file.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["vitest.config.ts"],
  "exclude": ["node_modules", "apps", "packages", "docs"]
}
